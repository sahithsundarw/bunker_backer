# --- Python ---
.venv/
.venv-mac/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Outputs / artifacts ---
logs/
reviews/
runs/
wandb/
outputs/

results/*

# --- Archives & model weights (ignored by default; final checkpoint exempted below) ---
*.zip
*.tar
*.tar.gz
*.7z
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Submission Route A: the verified 3.14 MiB default checkpoint must be present in a clone.
!weights/best.pt

# Byte-identical mirror added for the organizers' announced submission-folder shape
# (docs/decisions.md D75) -- must be present in a clone the same way weights/best.pt is.
!models/best.pt

# --- Dataset: lives at C:\kla-data, OUTSIDE this repo. Never commit image data. ---
# Belt-and-braces in case anything is ever copied or symlinked in.
/kla-data/
kla-data/
data/
train/
test_NoisyLR/
**/GT/
**/NoisyLR/
# NOTE: *.npy is ignored, but SPEC F12 requires results/restored_test_outputs/ to
# contain real model outputs -- which are .npy. 400 x 256x256 float32 is ~105 MB,
# over GitHub's limit, so that folder needs Git LFS or a hosted link + sha256.
# Decide before submission; see docs/decisions.md.
*.npy
*.npz
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*.bmp
__MACOSX/
.DS_Store
._*

# --- Verifier fixtures: generated at runtime by scripts/verify_all.py, never committed ---
tests/fixtures/

# --- Local env / editor ---
.env
.env.local
.vscode/
.idea/
Thumbs.db

# --- Exceptions (MUST stay last: later rules override earlier ones) ---
# results/eda/ was in the original ignore list, but SPEC 12 lists it as a required
# repo item and SPEC 14 makes results/eda/noise_variance_vs_intensity.png mandatory
# Slide 3 content. The figures total well under 1 MB, so they are tracked.
# To revert: delete this whole block and add "results/eda/" above.
!results/eda/
!results/eda/*.png
!results/eda/*.json
!results/eda/*.txt
!results/restored_test_outputs/
!results/restored_test_outputs/.gitkeep
# V48 reads results/metrics_summary.md from a FRESH CLONE, and Definition-of-Done #2 requires
# fresh-clone verification -- so the table must be tracked. results/baselines/** stays ignored
# (1200 .npy predictions live there).
!results/metrics_summary.md
# sample_inputs/ holds 6 real test_NoisyLR files (394 KB total). V47 runs inference against
# this folder from a clean clone, so they must be tracked despite the blanket *.npy rule.
# These are degraded INPUTS only -- no ground truth is committed anywhere in this repo.
!sample_inputs/
!sample_inputs/*.npy
!results/degrade_fidelity/
!results/degrade_fidelity/*.png
!results/degrade_fidelity/*.json
# V49 reads results/qualitative/ and Definition-of-Done #2 requires fresh-clone verification,
# so the figures must be in the clone -- without these negations V49 passes on the author's
# machine and fails for everyone else, which is the same class of defect V59 was added to
# catch. 9 files, 2.13 MB total, against V51's 5 MB per-file and 25 MB whole-tree caps.
!results/qualitative/
!results/qualitative/*.png
!results/qualitative/*.json
!results/qualitative/*.md
# V45 needs >=2 experiments.csv rows and V48 needs >=4 metrics.json records including
# `final`, both read from results/, which is otherwise entirely ignored -- so a fresh clone
# had ZERO of either and both checks passed on the author's box only, the exact
# green-here/red-in-a-clone defect V59 exists to catch (reintroduced by the D31
# strengthening that added this requirement). Track only the ledger and the five metrics
# records (~300 KB total) -- NOT the 2000 .npy predictions per baseline, which would blow
# V51's 25 MB whole-tree cap.
!results/experiments.csv
!results/baselines/
!results/baselines/*/
!results/baselines/*/metrics.json
# Negating the directories above re-exposes their other contents too (pred_meta.json, the
# 2000 .npy predictions) to the *.npy rule and later patterns -- .npy stays caught by the
# blanket rule above, but pred_meta.json is not, so it needs its own explicit re-ignore.
results/baselines/*/pred_meta.json
# V37/V39/V43 read results/runtime_report.md from the repo -- same fresh-clone hole as
# experiments.csv/metrics.json above. 10 KB, machine-generated by
# scripts/benchmark_runtime.py report; never hand-edit it.
!results/runtime_report.md
# Dual-resolution (256->512) companion report, same reason. See docs/decisions.md D45.
!results/runtime_report_512.md
# Per-baseline throughput reports (D77) -- same reason: README's comparison table cites
# these, so they need to survive a fresh clone too.
!results/runtime_report_unet.md
!results/runtime_report_bicubic.md
!results/runtime_report_median.md
!results/runtime_report_nlm.md
